-- Auto-update bed status on admission/discharge
CREATE OR REPLACE FUNCTION update_bed_on_admission()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.bed_id IS NOT NULL AND (TG_OP = 'INSERT' OR OLD.bed_id IS DISTINCT FROM NEW.bed_id) THEN
        UPDATE beds SET status = 'Occupied' WHERE id = NEW.bed_id;
        IF OLD.bed_id IS NOT NULL AND OLD.bed_id != NEW.bed_id THEN
            UPDATE beds SET status = 'Available' WHERE id = OLD.bed_id;
        END IF;
    END IF;
    IF NEW.status IN ('Discharged', 'Deceased') AND OLD.status NOT IN ('Discharged', 'Deceased') THEN
        UPDATE beds SET status = 'Available' WHERE id = NEW.bed_id;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_admission_bed AFTER INSERT OR UPDATE ON admissions FOR EACH ROW EXECUTE FUNCTION update_bed_on_admission();

-- Auto-update invoice status on payment
CREATE OR REPLACE FUNCTION update_invoice_on_payment()
RETURNS TRIGGER AS $$
DECLARE
    v_total NUMERIC;
    v_paid NUMERIC;
BEGIN
    SELECT total_amount INTO v_total FROM invoices WHERE id = NEW.invoice_id;
    SELECT COALESCE(SUM(amount), 0) INTO v_paid FROM payments WHERE invoice_id = NEW.invoice_id;
    
    UPDATE invoices SET
        paid_amount = v_paid,
        status = CASE
            WHEN v_paid >= v_total THEN 'Paid'
            WHEN v_paid > 0 THEN 'Partial'
            ELSE 'Unpaid'
        END
    WHERE id = NEW.invoice_id;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_payment_invoice AFTER INSERT ON payments FOR EACH ROW EXECUTE FUNCTION update_invoice_on_payment();

-- Auto-update medicine stock on movement
CREATE OR REPLACE FUNCTION update_stock_on_movement()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.movement_type IN ('IN', 'RETURN') THEN
        UPDATE medicines SET stock_quantity = stock_quantity + NEW.quantity WHERE id = NEW.medicine_id;
    ELSIF NEW.movement_type IN ('OUT', 'EXPIRED') THEN
        UPDATE medicines SET stock_quantity = stock_quantity - NEW.quantity WHERE id = NEW.medicine_id;
    ELSIF NEW.movement_type = 'ADJUSTMENT' THEN
        UPDATE medicines SET stock_quantity = NEW.quantity WHERE id = NEW.medicine_id;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_stock_movement AFTER INSERT ON stock_movements FOR EACH ROW EXECUTE FUNCTION update_stock_on_movement();

-- Generate sequential patient number
CREATE OR REPLACE FUNCTION generate_patient_number()
RETURNS TRIGGER AS $$
DECLARE
    seq_val INTEGER;
BEGIN
    SELECT COALESCE(MAX(CAST(SUBSTRING(patient_number FROM 4) AS INTEGER)), 0) + 1
    INTO seq_val FROM patients;
    NEW.patient_number = 'PT-' || LPAD(seq_val::TEXT, 6, '0');
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_patient_number BEFORE INSERT ON patients FOR EACH ROW WHEN (NEW.patient_number IS NULL) EXECUTE FUNCTION generate_patient_number();

