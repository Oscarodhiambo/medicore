-- VIEWS (for common queries)
-- ============================================================

-- Active admissions with full details
CREATE VIEW v_active_admissions AS
SELECT
    a.id,
    a.admission_number,
    p.patient_number,
    p.first_name || ' ' || p.last_name AS patient_name,
    p.date_of_birth,
    p.gender,
    d.name AS department,
    w.name AS ward,
    b.bed_number,
    s.first_name || ' ' || s.last_name AS doctor_name,
    a.status,
    a.admission_date,
    a.diagnosis,
    a.is_emergency
FROM admissions a
JOIN patients p ON p.id = a.patient_id
JOIN departments d ON d.id = a.department_id
LEFT JOIN wards w ON w.id = a.ward_id
LEFT JOIN beds b ON b.id = a.bed_id
JOIN staff s ON s.id = a.attending_doctor_id
WHERE a.status NOT IN ('Discharged', 'Deceased');

-- Bed occupancy overview
CREATE VIEW v_bed_occupancy AS
SELECT
    w.name AS ward,
    w.floor,
    COUNT(*) AS total_beds,
    COUNT(*) FILTER (WHERE b.status = 'Occupied') AS occupied,
    COUNT(*) FILTER (WHERE b.status = 'Available') AS available,
    COUNT(*) FILTER (WHERE b.status = 'Maintenance') AS maintenance,
    ROUND(COUNT(*) FILTER (WHERE b.status = 'Occupied')::NUMERIC / COUNT(*)::NUMERIC * 100, 1) AS occupancy_pct
FROM beds b
JOIN wards w ON w.id = b.ward_id
GROUP BY w.name, w.floor
ORDER BY occupancy_pct DESC;

-- Today's appointments
CREATE VIEW v_today_appointments AS
SELECT
    ap.appointment_number,
    p.first_name || ' ' || p.last_name AS patient_name,
    s.first_name || ' ' || s.last_name AS doctor_name,
    d.name AS department,
    ap.appointment_time,
    ap.type,
    ap.status
FROM appointments ap
JOIN patients p ON p.id = ap.patient_id
JOIN staff s ON s.id = ap.doctor_id
JOIN departments d ON d.id = ap.department_id
WHERE ap.appointment_date = CURRENT_DATE
ORDER BY ap.appointment_time;

-- Outstanding invoices
CREATE VIEW v_outstanding_invoices AS
SELECT
    i.invoice_number,
    p.first_name || ' ' || p.last_name AS patient_name,
    i.total_amount,
    i.paid_amount,
    i.balance,
    i.status,
    i.due_date,
    CASE WHEN i.due_date < CURRENT_DATE THEN true ELSE false END AS is_overdue
FROM invoices i
JOIN patients p ON p.id = i.patient_id
WHERE i.status IN ('Unpaid', 'Partial')
ORDER BY i.due_date;

-- Low stock medicines
CREATE VIEW v_low_stock_medicines AS
SELECT
    m.code,
    m.name,
    mc.name AS category,
    m.stock_quantity,
    m.reorder_level,
    m.unit_price,
    s.name AS supplier,
    m.expiry_date
FROM medicines m
LEFT JOIN medicine_categories mc ON mc.id = m.category_id
LEFT JOIN suppliers s ON s.id = m.supplier_id
WHERE m.stock_quantity <= m.reorder_level AND m.is_active = true
ORDER BY m.stock_quantity;

-- Staff on duty today
CREATE VIEW v_staff_on_duty AS
SELECT
    s.staff_number,
    s.first_name || ' ' || s.last_name AS name,
    s.role,
    d.name AS department,
    s.specialization,
    sh.name AS shift,
    ss.is_on_call,
    w.name AS assigned_ward
FROM staff_schedules ss
JOIN staff s ON s.id = ss.staff_id
JOIN shifts sh ON sh.id = ss.shift_id
JOIN departments d ON d.id = s.department_id
LEFT JOIN wards w ON w.id = ss.ward_id
WHERE ss.schedule_date = CURRENT_DATE AND s.is_active = true
ORDER BY s.role, s.last_name;

