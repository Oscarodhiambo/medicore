-- Create roles
DO $$
BEGIN
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'medicore_admin') THEN
        CREATE ROLE medicore_admin;
    END IF;
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'medicore_doctor') THEN
        CREATE ROLE medicore_doctor;
    END IF;
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'medicore_nurse') THEN
        CREATE ROLE medicore_nurse;
    END IF;
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'medicore_billing') THEN
        CREATE ROLE medicore_billing;
    END IF;
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'medicore_readonly') THEN
        CREATE ROLE medicore_readonly;
    END IF;
END $$;

-- Admin: full access
GRANT ALL ON ALL TABLES IN SCHEMA public TO medicore_admin;
GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO medicore_admin;

-- Doctor: patients, admissions, appointments, labs, prescriptions
GRANT SELECT, INSERT, UPDATE ON patients, admissions, appointments, vitals, lab_orders, prescriptions, prescription_items TO medicore_doctor;
GRANT SELECT ON departments, wards, beds, staff, medicines, lab_test_types TO medicore_doctor;

-- Nurse: vitals, admissions (update status), beds
GRANT SELECT ON patients, admissions, appointments, departments, wards, staff TO medicore_nurse;
GRANT SELECT, INSERT, UPDATE ON vitals TO medicore_nurse;
GRANT UPDATE (status) ON admissions TO medicore_nurse;
GRANT UPDATE (status) ON beds TO medicore_nurse;

-- Billing: invoices, payments
GRANT SELECT ON patients, admissions TO medicore_billing;
GRANT SELECT, INSERT, UPDATE ON invoices, invoice_items, payments, insurance_claims TO medicore_billing;

-- Readonly
GRANT SELECT ON ALL TABLES IN SCHEMA public TO medicore_readonly;
